pnpm exec lint-staged

# Секрет-скан staged-змін. Якщо gitleaks не встановлено — попередження, а не тихий пропуск.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml --no-banner || exit 1
else
  echo "WARNING: gitleaks не встановлено — секрет-скан пропущено. Встановіть: https://github.com/gitleaks/gitleaks"
fi

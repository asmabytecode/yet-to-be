# Скопіюйте у .env командою `pnpm secrets:generate` — секрети згенеруються автоматично.
# Цей файл комітиться; справжній .env — НІКОЛИ.

# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000
API_PREFIX=api
TRUST_PROXY=false
# Лише для тестів; у production має бути false (інакше API не стартує)
THROTTLE_DISABLED=false

# ---- Database ----
DATABASE_URL=file:./data/yettobe.db

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-min-64-chars
JWT_ACCESS_TTL=15m
JWT_ISSUER=yet-to-be-api
JWT_AUDIENCE=yet-to-be-web
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_PEPPER=change-me
COOKIE_SECRET=change-me

# ---- Encryption (base64, рівно 32 байти на ключ) ----
DATA_ENCRYPTION_KEYS={"k1":"change-me-base64-32-bytes"}
DATA_ENCRYPTION_ACTIVE_KEY_ID=k1
BLIND_INDEX_KEY=change-me-base64-32-bytes

# ---- Google OAuth (отримати в Google Cloud Console, Етап 7) ----
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_CALLBACK_URL=http://localhost:5173/api/v1/auth/google/callback

# ---- Frontend (ПУБЛІЧНІ значення, потрапляють у бандл!) ----
VITE_PUBLIC_APP_NAME=YET TO BE

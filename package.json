{
  "name": "yet-to-be",
  "private": true,
  "version": "0.0.0",
  "description": "YET TO BE — monorepo (NestJS API + React web)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:cov": "turbo run test:cov",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:all": "turbo run lint typecheck test:cov build",
    "stack:up": "docker compose up -d --build",
    "stack:e2e": "docker compose -f docker-compose.yml -f docker-compose.e2e.yml up -d --build",
    "stack:down": "docker compose down",
    "stack:wait": "node scripts/wait-for.mjs http://localhost:8080/api/v1/health/ready",
    "check:headers": "node scripts/check-headers.mjs http://localhost:8080",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter api db:migrate:deploy",
    "db:seed": "pnpm --filter api db:seed",
    "db:studio": "pnpm --filter api db:studio",
    "db:reset": "pnpm --filter api db:reset",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "secrets:scan": "gitleaks detect --source . --config .gitleaks.toml --no-banner",
    "prepare": "husky",
    "db:backup": "pnpm --filter api db:backup",
    "owner:grant": "pnpm --filter api run owner:grant",
    "audit:verify": "pnpm --filter api run audit:verify"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  }
}

{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node ../../scripts/check-dist-secrets.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-query": "^5.60.0",
    "@yet-to-be/shared": "workspace:*",
    "@yet-to-be/ui": "workspace:*",
    "i18next": "^26.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-i18next": "^16.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@yet-to-be/eslint-config": "workspace:*",
    "@yet-to-be/tsconfig": "workspace:*",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.7.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
